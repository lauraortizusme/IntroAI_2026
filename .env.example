# Copia este archivo a .env y completa la clave. NO subas .env al repositorio.
NVIDIA_API_KEY=tu_clave_aqui

# Opcionales (valores por defecto entre paréntesis)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Modelos probados con la cuenta gratuita el 2026-11-11 (los anteriores, meta/llama-3.3-70b-instruct y
# nvidia/llama-3.2-nv-embedqa-1b-v2, fueron retirados por NVIDIA: 410 Gone).
# Modelo de lenguaje usado en la evaluación (function calling verificado):
# NVIDIA_LLM_MODEL=mistralai/mistral-large-4-1t-a52b
# Modelo de embeddings con el que se generó data/catalog.embeddings.npy (cambiarlo exige regenerar el índice):
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
# MAX_TOOL_CALLS=5
# CATALOG_PATH=data/catalog.csv
